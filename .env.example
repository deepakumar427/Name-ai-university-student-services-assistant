# Copy to .env and adjust. Real environment variables override this file.

# --- LLM (Ollama) ---
OLLAMA_BASE_URL=http://localhost:11434      # when running outside Docker
# DOCKER_OLLAMA_BASE_URL=http://host.docker.internal:11434   # used by docker-compose (this is the default)
OLLAMA_MODEL=qwen2.5:3b                     # alternatives: qwen2.5:7b-instruct, llama3
OLLAMA_TIMEOUT=120
MOCK_LLM=false                              # true = run without Ollama (keyword classifier + quoted answers)
LLM_CLASSIFY=true                           # use the LLM to classify questions (keyword fallback always on)

# --- Retrieval ---
RETRIEVAL_TOP_K=12
EVIDENCE_K=6
SIMILARITY_THRESHOLD=0.40
CONFLICT_MARGIN=0.12
CHUNK_SIZE=1200
CHUNK_OVERLAP=150

# --- Storage ---
# DATA_DIR=./data                           # app.db (SQLite) and chroma/ live here
# DOCUMENTS_DIR=./data/documents

# --- Limits ---
MAX_QUESTION_CHARS=1000
MAX_UPLOAD_MB=20
# DEFAULT_AS_OF_DATE=2026-10-06             # leave unset to use today's date

# --- Authentication ---
JWT_SECRET=                                 # REQUIRED for real use: long random string, e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`
                                            # empty = random per start (everyone must log in again after a restart)
JWT_EXPIRE_MINUTES=60
BCRYPT_ROUNDS=12
DEMO_STUDENT_PASSWORD=Student@2026          # given to seeded students that have no password yet (demo only)
